{
  "name": "Snail Derby",
  "icon": {
    "image": "brand/icon.png",
    "emoji": "🐌"
  },
  "secrets": [],
  "tests": [
    {
      "id": "home.daily-derby",
      "name": "Snail Derby home shows the Daily Derby card",
      "path": "/?tab=history",
      "expectText": "DAILY DERBY",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js",
        "derby-totals.js"
      ]
    },
    {
      "name": "Daily Derby card shows the current description",
      "path": "/?tab=history",
      "expectText": "Pick a snail, watch the race, earn $NAIL points, and climb the leaderboard."
    },
    {
      "name": "Daily Derby card shows Free, 8 Races, 6 Snails",
      "path": "/?tab=history",
      "expectText": "Free · 8 Races · 6 Snails"
    },
    {
      "name": "Daily Derby card shows $NAIL score",
      "path": "/",
      "expectSelector": "#daily-derby [data-score]"
    },
    {
      "name": "Daily Derby card shows an ALL-TIME $NAIL total that persists across days",
      "path": "/",
      "expectSelector": "#derby-log [data-lifetime]"
    },
    {
      "name": "Race tab shows the ALL-TIME $NAIL total next to the race progress",
      "path": "/",
      "expectSelector": "#race-progress [data-progress-alltime][data-lifetime]"
    },
    {
      "name": "Daily Derby card shows YESTERDAY $NAIL",
      "path": "/",
      "expectSelector": "#derby-log [data-yesterday]"
    },
    {
      "id": "home.leaderboard",
      "name": "Daily Derby Leaderboard shows verified $NAIL scores",
      "path": "/?demo=1&tab=leaderboard",
      "expectSelector": "#leaderboard [data-rank=\"10\"]",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js",
        "leaderboard-config.js",
        "nail-config.js"
      ]
    },
    {
      "name": "Leaderboard shows shortened wallet addresses",
      "path": "/?demo=1&tab=leaderboard",
      "expectText": "ut1sta…0001"
    },
    {
      "name": "Leaderboard header says Today's top scores",
      "path": "/?tab=leaderboard",
      "expectText": "Today's top scores"
    },
    {
      "name": "Leaderboard shows the player's own rank panel",
      "path": "/",
      "expectSelector": "#leaderboard [data-your-rank]"
    },
    {
      "name": "Your Rank panel labels render",
      "path": "/?demo=1&tab=leaderboard",
      "expectText": "Your Rank"
    },
    {
      "name": "Leaderboard is a game score only",
      "path": "/?tab=leaderboard",
      "expectText": "$NAIL is a game score only"
    },
    {
      "name": "Leaderboard loads",
      "path": "/",
      "expectSelector": "#leaderboard[data-loaded]"
    },
    {
      "id": "home.race-card",
      "name": "Race Card shows six snails waiting for a pick",
      "path": "/",
      "expectSelector": "#race-card[data-race=\"1\"][data-state=\"waiting\"] [data-snail=\"cycle_o\"] [data-pattern=\"solid\"]",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js",
        "nail-config.js",
        "public/derby-stories.js"
      ]
    },
    {
      "name": "Race Card RUN RACE button renders",
      "path": "/",
      "expectText": "RUN RACE"
    },
    {
      "name": "Race Card shows Lucas",
      "path": "/",
      "expectText": "Lucas"
    },
    {
      "name": "Race Card shows a Stamina value for every snail",
      "path": "/",
      "expectSelector": "#race-snails [data-snail=\"drea\"] [data-sta]"
    },
    {
      "name": "Race Card header names the Stamina column",
      "path": "/",
      "expectText": "Stamina"
    },
    {
      "name": "Race Card shows an energy bar in every lane",
      "path": "/",
      "expectSelector": "#race-lanes [data-lane] [data-energy]"
    },
    {
      "id": "home.derby-progress",
      "name": "Race Card shows PICK A SNAIL with an eight-step progress strip",
      "path": "/",
      "expectSelector": "#race-card[data-stage=\"pick\"] #race-progress [data-step=\"1\"][data-step-state=\"current\"]",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/derby-stories.js"
      ]
    },
    {
      "name": "Progress strip shows RACE 1 / 8",
      "path": "/",
      "expectText": "RACE 1 / 8"
    },
    {
      "name": "Progress strip has eight steps",
      "path": "/",
      "expectSelector": "#race-progress [data-step=\"8\"][data-step-state=\"upcoming\"]"
    },
    {
      "name": "Race Card shows the PICK A SNAIL state",
      "path": "/",
      "expectText": "PICK A SNAIL"
    },
    {
      "name": "Daily Derby card lists all eight races",
      "path": "/",
      "expectSelector": "#derby-log [data-log-race=\"8\"][data-log-state=\"upcoming\"]"
    },
    {
      "name": "Race tab is the default view and shows only the Race Card",
      "path": "/",
      "expectSelector": "#tab-race[aria-selected=\"true\"] ~ #tab-leaderboard[aria-selected=\"false\"] ~ #tab-history[aria-selected=\"false\"]"
    },
    {
      "name": "Leaderboard and History panels are hidden on the Race tab",
      "path": "/",
      "expectSelector": "#panel-race:not([hidden]) ~ #panel-leaderboard[hidden] ~ #panel-history[hidden]"
    },
    {
      "id": "cage.snails",
      "name": "Cage tab shows all six snails with care and customization",
      "path": "/?tab=cage",
      "expectSelector": "#panel-cage:not([hidden]) #cage-snails [data-cage-snail=\"drea\"]",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/snail-cage.js"
      ]
    },
    {
      "id": "tabs.leaderboard",
      "name": "Leaderboard tab shows the leaderboard and hides the Race Card",
      "path": "/?demo=1&tab=leaderboard",
      "expectSelector": "#panel-race[hidden] ~ #panel-leaderboard:not([hidden]) #leaderboard[data-loaded]",
      "visual": true,
      "impact": [
        "public/index.html"
      ]
    },
    {
      "name": "History tab shows the Daily Derby race log",
      "path": "/?tab=history",
      "expectSelector": "#panel-history:not([hidden]) #derby-log [data-log-race=\"8\"]"
    },
    {
      "id": "home.past-races",
      "name": "Past races card shows on the History tab",
      "path": "/?tab=history",
      "expectText": "PAST RACES",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js",
        "derby-totals.js"
      ]
    },
    {
      "name": "Past races card loads",
      "path": "/?tab=history",
      "expectSelector": "#race-history[data-loaded]"
    },
    {
      "name": "Past races card says so when there are no past races yet",
      "path": "/?tab=history",
      "expectSelector": "#race-history[data-loaded] [data-history-empty]"
    },
    {
      "id": "race.how-it-works",
      "name": "Race tab shows the How it works card with a Full guide button",
      "path": "/",
      "expectSelector": "#panel-race:not([hidden]) #how-it-works #how-open[aria-haspopup=\"dialog\"]",
      "visual": true,
      "impact": [
        "public/index.html"
      ]
    },
    {
      "name": "How it works summary explains the game",
      "path": "/",
      "expectText": "Faster snails win more often, but long shots earn more $NAIL."
    },
    {
      "id": "race.browser-wallet",
      "name": "Race tab shows the Browser wallet card",
      "path": "/",
      "expectSelector": "#panel-race:not([hidden]) #browser-wallet[data-wallet-state]",
      "visual": true,
      "impact": [
        "public/index.html"
      ]
    },
    {
      "name": "Browser wallet card is labelled",
      "path": "/",
      "expectText": "BROWSER WALLET"
    },
    {
      "id": "arena.maps",
      "name": "Arena tab lists all five maps with canvas thumbnails",
      "path": "/?tab=arena",
      "expectSelector": "#arena-maps [data-map=\"volcano\"] canvas",
      "visual": true,
      "impact": [
        "public/arena/**",
        "public/index.html"
      ]
    },
    {
      "name": "Arena shows Meadow, Desert, Forest, Candy and Volcano cards",
      "path": "/?tab=arena",
      "expectSelector": "#arena-maps [data-map=\"meadow\"] ~ [data-map=\"desert\"] ~ [data-map=\"forest\"] ~ [data-map=\"candy\"] ~ [data-map=\"volcano\"]"
    },
    {
      "id": "arena.preview",
      "name": "Arena race preview follows the map in the URL",
      "path": "/?tab=arena&map=candy",
      "expectSelector": "#arena-preview[data-map=\"candy\"] #arena-preview-canvas",
      "visual": true,
      "impact": [
        "public/arena/**",
        "public/index.html"
      ]
    },
    {
      "name": "Arena offers laps, opponents difficulty and a Start race button",
      "path": "/?tab=arena",
      "expectSelector": "#arena-laps [data-value=\"3\"] ~ [data-value=\"5\"], #arena-difficulty [data-value=\"hard\"], #arena-start"
    },
    {
      "name": "Arena panel is hidden on the Race tab and Race tab still works",
      "path": "/",
      "expectSelector": "#panel-race:not([hidden]) ~ #panel-arena[hidden]"
    },
    {
      "id": "tabs.cage",
      "name": "Cage tab shows all six snails",
      "path": "/?tab=cage",
      "expectSelector": "#panel-cage:not([hidden]) #cage[data-loaded] [data-cage-snail=\"drea\"]",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js",
        "cage.js"
      ]
    },
    {
      "name": "Cage tab shows the SNAIL CAGE heading",
      "path": "/?tab=cage",
      "expectText": "SNAIL CAGE"
    },
    {
      "name": "Cage tab shows the feed action",
      "path": "/?tab=cage",
      "expectSelector": "#cage [data-cage-action=\"feed\"]"
    },
    {
      "name": "Cage tab shows the crown hat option",
      "path": "/?tab=cage",
      "expectSelector": "#cage [data-cage-hat=\"crown\"]"
    },
    {
      "name": "Cage tab sits after History and is not selected by default",
      "path": "/",
      "expectSelector": "#tab-history ~ #tab-cage[aria-selected=\"false\"]"
    }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  },
  "admins": [
    "banditiaeja"
  ]
}
