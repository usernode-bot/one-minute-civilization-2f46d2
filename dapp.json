{
  "name": "Snail Derby",
  "icon": {
    "image": "brand/icon.png"
  },
  "secrets": [],
  "tests": [
    {
      "id": "home.daily-derby",
      "name": "Snail Derby home shows the Daily Derby card",
      "path": "/",
      "expectText": "DAILY DERBY",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js"
      ]
    },
    {
      "name": "Daily Derby card shows $NAIL score",
      "path": "/",
      "expectSelector": "#daily-derby [data-score]"
    },
    {
      "id": "home.leaderboard",
      "name": "Daily Derby Leaderboard shows verified $NAIL scores",
      "path": "/?demo=1",
      "expectSelector": "#leaderboard [data-rank=\"10\"]",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js",
        "leaderboard-config.js",
        "nail-config.js"
      ]
    },
    {
      "name": "Leaderboard shows shortened wallet addresses",
      "path": "/?demo=1",
      "expectText": "ut1sta…0001"
    },
    {
      "name": "Leaderboard header says Today's top scores",
      "path": "/",
      "expectText": "Today's top scores"
    },
    {
      "name": "Leaderboard shows the player's own rank panel",
      "path": "/",
      "expectSelector": "#leaderboard [data-your-rank]"
    },
    {
      "name": "Your Rank panel labels render",
      "path": "/?demo=1",
      "expectText": "Your Rank"
    },
    {
      "name": "Leaderboard is a game score only",
      "path": "/",
      "expectText": "$NAIL is a game score only"
    },
    {
      "name": "Leaderboard loads",
      "path": "/",
      "expectSelector": "#leaderboard[data-loaded]"
    },
    {
      "id": "home.race-card",
      "name": "Race Card shows six snails waiting for a pick",
      "path": "/",
      "expectSelector": "#race-card[data-race=\"1\"][data-state=\"waiting\"] [data-snail=\"cycle_o\"]",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js",
        "nail-config.js",
        "public/derby-stories.js"
      ]
    },
    {
      "name": "Race Card RUN RACE button renders",
      "path": "/",
      "expectText": "RUN RACE"
    },
    {
      "name": "Race Card shows Lucas",
      "path": "/",
      "expectText": "Lucas"
    }
  ]
}
