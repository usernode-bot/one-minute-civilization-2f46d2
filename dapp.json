{
  "name": "Snail Derby",
  "icon": {
    "emoji": "🐌"
  },
  "secrets": [],
  "tests": [
    {
      "id": "home.daily-derby",
      "name": "Snail Derby home shows the Daily Derby card",
      "path": "/?tab=history",
      "expectText": "DAILY DERBY",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js"
      ]
    },
    {
      "name": "Daily Derby card shows the current description",
      "path": "/?tab=history",
      "expectText": "Pick a snail, watch the race, earn $NAIL points, and climb the leaderboard."
    },
    {
      "name": "Daily Derby card shows Free, 8 Races, 6 Snails",
      "path": "/?tab=history",
      "expectText": "Free · 8 Races · 6 Snails"
    },
    {
      "name": "Daily Derby card shows $NAIL score",
      "path": "/",
      "expectSelector": "#daily-derby [data-score]"
    },
    {
      "name": "Daily Derby card shows an ALL-TIME $NAIL total that persists across days",
      "path": "/",
      "expectSelector": "#derby-log [data-lifetime]"
    },
    {
      "name": "Race tab shows the ALL-TIME $NAIL total next to the race progress",
      "path": "/",
      "expectSelector": "#race-progress [data-progress-alltime][data-lifetime]"
    },
    {
      "name": "Daily Derby card shows YESTERDAY $NAIL",
      "path": "/",
      "expectSelector": "#derby-log [data-yesterday]"
    },
    {
      "id": "home.leaderboard",
      "name": "Daily Derby Leaderboard shows verified $NAIL scores",
      "path": "/?demo=1&tab=leaderboard",
      "expectSelector": "#leaderboard [data-rank=\"10\"]",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js",
        "leaderboard-config.js",
        "nail-config.js"
      ]
    },
    {
      "name": "Leaderboard shows shortened wallet addresses",
      "path": "/?demo=1&tab=leaderboard",
      "expectText": "ut1sta…0001"
    },
    {
      "name": "Leaderboard header says Today's top scores",
      "path": "/?tab=leaderboard",
      "expectText": "Today's top scores"
    },
    {
      "name": "Leaderboard shows the player's own rank panel",
      "path": "/",
      "expectSelector": "#leaderboard [data-your-rank]"
    },
    {
      "name": "Your Rank panel labels render",
      "path": "/?demo=1&tab=leaderboard",
      "expectText": "Your Rank"
    },
    {
      "name": "Leaderboard is a game score only",
      "path": "/?tab=leaderboard",
      "expectText": "$NAIL is a game score only"
    },
    {
      "name": "Leaderboard loads",
      "path": "/",
      "expectSelector": "#leaderboard[data-loaded]"
    },
    {
      "id": "home.race-card",
      "name": "Race Card shows six snails waiting for a pick",
      "path": "/",
      "expectSelector": "#race-card[data-race=\"1\"][data-state=\"waiting\"] [data-snail=\"cycle_o\"] [data-pattern=\"solid\"]",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js",
        "nail-config.js",
        "public/derby-stories.js"
      ]
    },
    {
      "name": "Race Card RUN RACE button renders",
      "path": "/",
      "expectText": "RUN RACE"
    },
    {
      "name": "Race Card shows Lucas",
      "path": "/",
      "expectText": "Lucas"
    },
    {
      "id": "home.derby-progress",
      "name": "Race Card shows PICK A SNAIL with an eight-step progress strip",
      "path": "/",
      "expectSelector": "#race-card[data-stage=\"pick\"] #race-progress [data-step=\"1\"][data-step-state=\"current\"]",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/derby-stories.js"
      ]
    },
    {
      "name": "Progress strip shows RACE 1 / 8",
      "path": "/",
      "expectText": "RACE 1 / 8"
    },
    {
      "name": "Progress strip has eight steps",
      "path": "/",
      "expectSelector": "#race-progress [data-step=\"8\"][data-step-state=\"upcoming\"]"
    },
    {
      "name": "Race Card shows the PICK A SNAIL state",
      "path": "/",
      "expectText": "PICK A SNAIL"
    },
    {
      "name": "Daily Derby card lists all eight races",
      "path": "/",
      "expectSelector": "#derby-log [data-log-race=\"8\"][data-log-state=\"upcoming\"]"
    },
    {
      "name": "Race tab is the default view and shows only the Race Card",
      "path": "/",
      "expectSelector": "#tab-race[aria-selected=\"true\"] ~ #tab-leaderboard[aria-selected=\"false\"] ~ #tab-history[aria-selected=\"false\"]"
    },
    {
      "name": "Leaderboard and History panels are hidden on the Race tab",
      "path": "/",
      "expectSelector": "#panel-race:not([hidden]) ~ #panel-leaderboard[hidden] ~ #panel-history[hidden]"
    },
    {
      "id": "tabs.leaderboard",
      "name": "Leaderboard tab shows the leaderboard and hides the Race Card",
      "path": "/?demo=1&tab=leaderboard",
      "expectSelector": "#panel-race[hidden] ~ #panel-leaderboard:not([hidden]) #leaderboard[data-loaded]",
      "visual": true,
      "impact": [
        "public/index.html"
      ]
    },
    {
      "name": "History tab shows the Daily Derby race log",
      "path": "/?tab=history",
      "expectSelector": "#panel-history:not([hidden]) #derby-log [data-log-race=\"8\"]"
    },
    {
      "id": "race.how-it-works",
      "name": "Race tab shows the How it works card with a Full guide button",
      "path": "/",
      "expectSelector": "#panel-race:not([hidden]) #how-it-works #how-open[aria-haspopup=\"dialog\"]",
      "visual": true,
      "impact": [
        "public/index.html"
      ]
    },
    {
      "name": "How it works summary explains the game",
      "path": "/",
      "expectText": "Faster snails win more often, but long shots earn more $NAIL."
    }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  },
  "admins": [
    "banditiaeja"
  ]
}
